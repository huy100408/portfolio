# All optional. Copy to .env.local for local overrides.

# Sub-path the site is served from (GitHub Pages project site), e.g. /portfolio. Empty for root.
NEXT_PUBLIC_BASE_PATH=

# Public URL of the site, used for Open Graph metadata.
NEXT_PUBLIC_SITE_URL=

# Build-time only: raises the GitHub API limit for scripts/snapshot-github.mjs. Never exposed to the browser.
GITHUB_TOKEN=
